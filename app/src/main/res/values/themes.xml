<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fieldmap" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/sig</item>
        <item name="colorAccent">@color/sig</item>
        <item name="colorControlActivated">@color/sig</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textColorHighlight">@color/sig</item>
        <item name="alertDialogTheme">@style/Theme.Fieldmap.Dialog</item>
    </style>

    <style name="Theme.Fieldmap.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="colorAccent">@color/sig</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- A small section label: monospace capitals, as .fm-label on the pages. -->
    <style name="Label">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
