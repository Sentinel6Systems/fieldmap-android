<?xml version="1.0" encoding="utf-8"?>
<!-- Things you press: square, one edge line; the edge turns green when pressed or on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/bg_control_pressed" />
    <item android:state_selected="true" android:drawable="@drawable/bg_control_active" />
    <item android:drawable="@drawable/bg_control_normal" />
</selector>
