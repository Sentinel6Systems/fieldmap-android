<?xml version="1.0" encoding="utf-8"?>
<!-- One screen: the map, a strip of position above it, four buttons on it, and one panel
     that slides over the lower part (the side, when the phone lies on its side). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <io.github.sentinel6systems.fieldmap.ui.AreaFrameView
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_crosshair" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark"
            app:tint="@color/sig" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/latlon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:lineSpacingMultiplier="1.15"
        android:maxWidth="340dp"
        android:padding="16dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/foot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="#b3ffffff"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="3dp">

        <io.github.sentinel6systems.fieldmap.ui.ScaleBarView
            android:id="@+id/scale"
            android:layout_width="130dp"
            android:layout_height="26dp" />

        <TextView
            android:id="@+id/attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/attribution"
            android:textColor="#111111"
            android:textSize="11sp" />
    </LinearLayout>

    <io.github.sentinel6systems.fieldmap.ui.MapButton
        android:id="@+id/menu"
        android:layout_width="@dimen/map_button"
        android:layout_height="@dimen/map_button"
        android:layout_gravity="bottom|start"
        android:src="@drawable/ic_menu"
        android:text="@string/menu" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <io.github.sentinel6systems.fieldmap.ui.MapButton
            android:id="@+id/zoomIn"
            android:layout_width="@dimen/map_button"
            android:layout_height="@dimen/map_button"
            android:contentDescription="@string/zoom_in"
            android:src="@drawable/ic_plus" />

        <io.github.sentinel6systems.fieldmap.ui.MapButton
            android:id="@+id/zoomOut"
            android:layout_width="@dimen/map_button"
            android:layout_height="@dimen/map_button"
            android:layout_marginTop="@dimen/gap"
            android:contentDescription="@string/zoom_out"
            android:src="@drawable/ic_minus" />

        <io.github.sentinel6systems.fieldmap.ui.MapButton
            android:id="@+id/position"
            android:layout_width="@dimen/map_button"
            android:layout_height="@dimen/map_button"
            android:layout_marginTop="22dp"
            android:src="@drawable/ic_locate"
            android:text="@string/follow" />

        <io.github.sentinel6systems.fieldmap.ui.MapButton
            android:id="@+id/mark"
            android:layout_width="@dimen/map_button"
            android:layout_height="76dp"
            android:layout_marginTop="@dimen/gap"
            android:src="@drawable/ic_dot"
            android:tag="primary"
            android:text="@string/mark" />
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_control_active"
        android:elevation="6dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:visibility="gone" />

    <io.github.sentinel6systems.fieldmap.ui.PanelLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/panelBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/back"
                android:padding="16dp"
                android:src="@drawable/ic_back"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/panelTitle"
                style="@style/Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/panelClose"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/close"
                android:padding="16dp"
                android:src="@drawable/ic_close"
                app:tint="@color/ink" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <ScrollView
            android:id="@+id/panelScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/panelBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </io.github.sentinel6systems.fieldmap.ui.PanelLayout>
</FrameLayout>
